def numba_composite(nominal_scalar_variable, nominal_scalar_variable_1):
    # sqr(i1)
    scalar_variable_8 = square_1(nominal_scalar_variable_1)
    # add(i0, sqr.0)
    scalar_variable_9 = add_1(nominal_scalar_variable, scalar_variable_8)
    # sqrt(add.0)
    scalar_variable_10 = sqrt(scalar_variable_9)
    # sign(sqrt.0)
    scalar_variable_11 = sign(scalar_variable_10)
    # GE(add.0, 0)
    scalar_variable_12 = greater_equal(scalar_variable_9, scalar_constant_22)
    # Switch(GE.0, add.0, nan)
    scalar_variable_13 = switch(scalar_variable_12, scalar_variable_9, scalar_constant_23)
    # reciprocal(Switch.0)
    scalar_variable_14 = reciprocal(scalar_variable_13)
    # mul(reciprocal.0, sign.0)
    scalar_variable_15 = mul_3(scalar_variable_14, scalar_variable_11)
    # GT(mul.0, 0)
    scalar_variable_16 = greater(scalar_variable_15, scalar_constant_22)
    return scalar_variable_16, scalar_variable_14, scalar_variable_11, scalar_variable_10